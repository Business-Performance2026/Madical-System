rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // دوال مساعدة
    // ============================================

    function isSignedIn() {
      return request.auth != null;
    }

    // بيانات المستخدم الحالي من مجموعة users (يكلف قراءة وحدة إضافية)
    function myData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && myData().role == 'admin' && myData().status == 'active';
    }

    function isActiveClinic(clinicUid) {
      return isSignedIn() && request.auth.uid == clinicUid
        && myData().role == 'clinic' && myData().status == 'active';
    }

    // موظف فعّال تابع لعيادة معيّنة (صلاحياته نفس صلاحيات العيادة على بيانات تلك العيادة بس)
    function isActiveStaffOf(clinicUid) {
      return isSignedIn() && myData().role == 'staff' && myData().status == 'active'
        && myData().staffOf == clinicUid;
    }

    // العيادة نفسها أو أحد موظفيها الفعّالين - يُستخدم لصلاحيات بيانات العيادة (أطباء/حجوزات/أقفال أوقات)
    function isClinicOrStaff(clinicUid) {
      return isActiveClinic(clinicUid) || isActiveStaffOf(clinicUid);
    }

    function isActivePatient() {
      return isSignedIn() && myData().role == 'patient' && myData().status == 'active';
    }

    // ============================================
    // users
    // ============================================
    match /users/{userId} {
      // المستخدم يقرأ بياناته هو، الأدمن يقرأ بيانات الجميع،
      // العيادة الأساسية تقرأ بيانات موظفيها هي بس،
      // وأي زائر (حتى بدون تسجيل دخول) يقدر يقرأ بيانات العيادات الفعّالة بس
      // (تظهر بالشاشة الرئيسية العامة - اسم وبريد العيادة يصير معلومة عامة، وهذا مقصود لأنها حساب منشأة)
      allow read: if (resource.data.role == 'clinic' && resource.data.status == 'active')
        || (isSignedIn() && (request.auth.uid == userId || isAdmin()))
        || (resource.data.role == 'staff' && isActiveClinic(resource.data.staffOf));

      // إنشاء حساب جديد عند التسجيل: المستخدم ينشئ مستنده هو بس،
      // وما يقدر يسجل نفسه كـ admin، والحالة الأولية لازم تكون صحيحة
      // رقم الجوال (واتساب) إجباري لأي حساب جديد (مريض أو عيادة)
      allow create: if (isSignedIn()
            && request.auth.uid == userId
            && request.resource.data.role in ['patient', 'clinic']
            && request.resource.data.status ==
                 (request.resource.data.role == 'clinic' ? 'pending' : 'active')
            && request.resource.data.name is string
            && request.resource.data.email is string
            && request.resource.data.phone is string)
        // العيادة الأساسية (مو موظف) تقدر تنشئ حساب موظف تابع لها، فعّال مباشرة بدون موافقة أدمن
        || (isActiveClinic(request.resource.data.staffOf)
            && request.resource.data.role == 'staff'
            && request.resource.data.status == 'active'
            && request.resource.data.name is string
            && request.resource.data.email is string);

      // تعديل: الأدمن يقدر يعدل أي حساب (موافقة عيادة / إيقاف / تفعيل)
      // المستخدم العادي يقدر يعدل بياناته (مثل الاسم) لكن ما يقدر يغيّر role أو status لحاله
      allow update: if isAdmin()
        || (isSignedIn() && request.auth.uid == userId
            && request.resource.data.role == resource.data.role
            && request.resource.data.status == resource.data.status);

      // حذف حساب: الأدمن بس
      allow delete: if isAdmin();
    }

    // ============================================
    // doctors
    // ============================================
    match /doctors/{doctorId} {
      // قراءة عامة حتى بدون تسجيل دخول (اسم وتخصص الطبيب معلومة عامة، تحتاجها الشاشة الرئيسية للتصفح والبحث)
      allow read: if true;

      // إنشاء طبيب: العيادة صاحبة الحساب أو أحد موظفيها، ولازم تكون فعّالة
      allow create: if isClinicOrStaff(request.resource.data.clinicId);

      // تعديل/حذف: العيادة المالكة لهذا الطبيب أو أحد موظفيها
      allow update, delete: if isClinicOrStaff(resource.data.clinicId);
    }

    // ============================================
    // bookings
    // ============================================
    match /bookings/{bookingId} {
      // المريض يشوف حجوزاته، العيادة وموظفيها يشوفون حجوزات العيادة، الأدمن يشوف الكل
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.patientId == request.auth.uid)
        || isClinicOrStaff(resource.data.clinicId);

      // إنشاء حجز جديد: مريض فعّال، مربوط بحسابه هو، وحالته الأولية pending دايماً
      allow create: if isActivePatient()
        && request.resource.data.patientId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.clinicId is string
        && request.resource.data.doctorId is string
        && request.resource.data.date is string
        && request.resource.data.time is string
        && request.resource.data.patientPhone is string;

      // تعديل: العيادة أو أحد موظفيها يقدر يقبل/يرفض/يعلّم لم يحضر/يعدّل التاريخ والوقت واسم ورقم جوال المريض بهذا الحجز،
      // والمريض صاحب الحجز يقدر يلغيه بس
      allow update: if (isClinicOrStaff(resource.data.clinicId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'date', 'time', 'patientName', 'patientPhone'])
            && request.resource.data.status in ['pending', 'accepted', 'rejected', 'no_show'])
        || (isActivePatient() && resource.data.patientId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && resource.data.status in ['pending', 'accepted']
            && request.resource.data.status == 'cancelled');

      // حذف حجز: الأدمن، أو العيادة صاحبة الحجز أو أحد موظفيها
      allow delete: if isAdmin() || isClinicOrStaff(resource.data.clinicId);
    }

    // ============================================
    // lockedSlots
    // مستند خفيف لكل وقت مقبول (طبيب + تاريخ + وقت بس، بدون أي بيانات شخصية)
    // يستخدمه المريض للتحقق من الأوقات المتاحة بدون قراءة حجوزات مرضى ثانين
    // ============================================
    match /lockedSlots/{lockId} {
      // أي مستخدم مسجّل دخول يقرأ (يحتاجها المريض عشان يشوف الأوقات المتاحة)
      allow read: if isSignedIn();

      // العيادة أو أحد موظفيها ينشئ القفل لما يقبل حجز
      allow create: if isClinicOrStaff(request.resource.data.clinicId);

      // حذف القفل: العيادة صاحبته، أو المريض لما يلغي حجزه المقبول
      // (نسمح بشكل عام لأي مستخدم فعّال لأن هذا المستند ما فيه بيانات حساسة أصلاً)
      allow delete: if isSignedIn();
    }

    // ============================================
    // reviews
    // تقييم المريض للطبيب بعد الزيارة - معرّف المستند نفسه = bookingId (يمنع تكرار التقييم لنفس الحجز)
    // ============================================
    match /reviews/{bookingId} {
      // قراءة عامة (حتى بدون تسجيل دخول) - يفيد بعرض تقييم الطبيب/العيادة بالشاشة الرئيسية
      allow read: if true;

      // إنشاء تقييم: مريض فعّال، على حجزه هو بس، وكان الحجز مقبول فعلاً (يعني زار العيادة)
      allow create: if isActivePatient()
        && request.resource.data.patientId == request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.doctorId is string
        && request.resource.data.clinicId is string
        && get(/databases/$(database)/documents/bookings/$(bookingId)).data.patientId == request.auth.uid
        && get(/databases/$(database)/documents/bookings/$(bookingId)).data.status == 'accepted';

      // تعديل: المريض صاحب التقييم يقدر يعدّل نجومه/تعليقه بس
      allow update: if isActivePatient() && resource.data.patientId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'comment'])
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5;

      // حذف: الأدمن بس (لإزالة تقييم مسيء مثلاً)
      allow delete: if isAdmin();
    }

    // ============================================
    // ads
    // إعلانات الشاشة الرئيسية - قراءة عامة، تحكم كامل للأدمن بس
    // ============================================
    match /ads/{adId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}
